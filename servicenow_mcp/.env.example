# Copy to .env (chmod 600) and fill in. SN_INSTANCE=mock runs a built-in fake instance (no other setting needed).
SN_INSTANCE=https://devNNNNNN.service-now.com
SN_CLIENT_ID=
SN_CLIENT_SECRET=
SN_GROUP=SynergyAI
SN_TAG_PREFIX=synergyai:
# dev, test or prod (default prod when missing). Only dev and test allow deploying automations into the instance.
SN_ENVIRONMENT=dev
# Where the server listens: register http://<host>:<port>/mcp in SynergyAI.
SN_HOST=127.0.0.1
SN_PORT=8772
# Optional: how often and how long wait_for_jobs checks (defaults 5 and 120; both at most 140).
# SN_WAIT_INTERVAL_S=5
# SN_WAIT_WINDOW_S=120
# Optional, for the deploy tool (dev/test only): a user that may install apps, and where npx lives.
# SN_INSTALL_USER=
# SN_INSTALL_PASSWORD=
# SN_NPX=npx
# Required for deploy: callers send 'Authorization: Bearer <this value>'. Use a long random string.
# SN_DEPLOY_TOKEN=
